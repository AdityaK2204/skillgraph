digraph ER {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=0.9, fontname="DejaVu Sans", pad=0.3, newrank=true, compound=true];
  node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [fontname="DejaVu Sans", fontsize=8, fontcolor="#4b5563", color="#6b7280", dir=both, arrowsize=0.8, penwidth=1.0];
  subgraph cluster_0 { label="Identity & profile"; labeljust=l; fontsize=11; fontcolor="#374151"; style="rounded,dashed"; color="#b8c0cc";
  USERS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>USERS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555"><B>UK</B></FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">email_address</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>citext + regex domain</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>bcrypt only (CHECK)</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">user_role</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>enum: student/mentor/admin</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">boolean</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">last_login_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>trigger</I></FONT></TD></TR></TABLE>>];
  PROFILES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>PROFILES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>profile_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK, UK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1:1 with USERS</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(120)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">education_level</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>CHECK list</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">institution</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(150)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">graduation_year</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">smallint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1980-2040</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">interests</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text[]</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>max 15</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">bio</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">weekly_hours</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">smallint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1-80</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">vector(384)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7a4fb0" POINT-SIZE="8"><I>pgvector</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  RESUMES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>RESUMES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>resume_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555"><B>UK</B></FONT></TD><TD ALIGN="LEFT">mongo_doc_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">char(24)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#2f8a57" POINT-SIZE="8"><I>-&gt; MongoDB resumes_raw</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(255)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">file_size_bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1 B - 5 MB</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">parse_status</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>pending/parsed/failed</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">skills_detected</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">smallint</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">uploaded_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  GOALS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#dbe6f4" ALIGN="LEFT"><B>GOALS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>goal_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">target_date</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1 active per user</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
  subgraph cluster_1 { label="Skill knowledge (mirrored in Neo4j)"; labeljust=l; fontsize=11; fontcolor="#374151"; style="rounded,dashed"; color="#b8c0cc";
  CAREER_ROLES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#e3ecdf" ALIGN="LEFT"><B>CAREER_ROLES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>role_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">serial</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555"><B>UK</B></FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(100)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">domain</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(60)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">seniority</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(10)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">neo4j_node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(64)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b5532f" POINT-SIZE="8"><I>-&gt; Neo4j :Role</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">vector(384)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7a4fb0" POINT-SIZE="8"><I>pgvector</I></FONT></TD></TR></TABLE>>];
  SKILLS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#e3ecdf" ALIGN="LEFT"><B>SKILLS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">serial</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555"><B>UK</B></FONT></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(80)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(30)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>CHECK list</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">aliases</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text[]</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>resume matching</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">effort_hours</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">smallint</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1-400</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">neo4j_node_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(64)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#b5532f" POINT-SIZE="8"><I>-&gt; Neo4j :Skill</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">vector(384)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7a4fb0" POINT-SIZE="8"><I>pgvector</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">search_tsv</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">tsvector</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>generated, GIN</I></FONT></TD></TR></TABLE>>];
  SKILL_PREREQUISITES [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#e3ecdf" ALIGN="LEFT"><B>SKILL_PREREQUISITES</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>prereq_skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>self-ref, no cycles</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">strength</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">numeric(3,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>0-1</I></FONT></TD></TR></TABLE>>];
  USER_SKILLS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#e3ecdf" ALIGN="LEFT"><B>USER_SKILLS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>user_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">claimed_level</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">proficiency</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1-5 (claim)</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">verified_level</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">proficiency</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>0-5, from evidence</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>self/resume/evidence</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">updated_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  ROLE_SKILLS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#e3ecdf" ALIGN="LEFT"><B>ROLE_SKILLS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>role_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">required_level</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">proficiency</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1-5</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">importance</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">numeric(3,2)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>0.05-1</I></FONT></TD></TR></TABLE>>];
  }
  subgraph cluster_2 { label="Projects & evidence"; labeljust=l; fontsize=11; fontcolor="#374151"; style="rounded,dashed"; color="#b8c0cc";
  PROJECTS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#f2e6da" ALIGN="LEFT"><B>PROJECTS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>project_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(120)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">text</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">repo_url</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">web_url</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>http(s) domain</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">started_on</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">completed_on</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">date</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>&gt;= started_on</I></FONT></TD></TR></TABLE>>];
  PROJECT_SKILLS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#f2e6da" ALIGN="LEFT"><B>PROJECT_SKILLS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>project_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  EVIDENCE [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#f2e6da" ALIGN="LEFT"><B>EVIDENCE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><U>evidence_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">skill_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">project_id</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>nullable, same owner</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">evidence_kind</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>enum</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(150)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">url</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">web_url</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>link or project</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">demonstrated_level</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">proficiency</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>1-5</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(10)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>pending/verified/rejected</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#1d4ed8"><B>FK</B></FONT></TD><TD ALIGN="LEFT">reviewed_by</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>mentor/admin, not owner</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">reviewed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">review_note</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">varchar(500)</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">submitted_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  }
  subgraph cluster_3 { label="Job market"; labeljust=l; fontsize=11; fontcolor="#374151"; style="rounded,dashed"; color="#b8c0cc";
