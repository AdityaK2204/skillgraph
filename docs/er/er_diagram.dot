> </TD><TD ALIGN="LEFT">posted_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">date</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">boolean</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">vector(384)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#7a4fb0" POINT-SIZE="8"><I>pgvector</I></FONT></TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">search_tsv</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">tsvector</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>generated, GIN</I></FONT></TD></TR></TABLE>>];
  JOB_SKILLS [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#8a94a3" BGCOLOR="white"><TR><TD COLSPAN="4" BGCOLOR="#ece2f2" ALIGN="LEFT"><B>JOB_SKILLS</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>job_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">uuid</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#9a3412"><B>PK, FK</B></FONT></TD><TD ALIGN="LEFT"><U>skill_id</U></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">integer</FONT></TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT">is_required</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">boolean</FONT></TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
