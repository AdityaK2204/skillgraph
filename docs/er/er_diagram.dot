ed_at</TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280">timestamptz</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#6b7280" POINT-SIZE="8"><I>trigger</I></FONT></TD></TR></TABLE>>];
