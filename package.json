{
  "name": "skillgraph",
  "version": "1.0.0",
  "private": true,
  "description": "SkillGraph \u2014 personal career intelligence and skill development engine (PostgreSQL + pgvector, MongoDB, Neo4j, Next.js)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:init": "tsx scripts/db-init.ts",
    "seed": "tsx scripts/seed.ts",
    "graph:sync": "tsx scripts/sync-graph.ts",
    "embed": "tsx scripts/reembed.ts",
    "setup": "npm run db:init && npm run seed && npm run graph:sync",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.2",
    "bcryptjs": "3.0.2",
    "jose": "5.10.0",
    "mongodb": "6.18.0",
    "neo4j-driver": "5.28.1",
    "next": "15.5.28",
    "pg": "8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "unpdf": "1.2.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "postcss": "8.5.30",
    "sharp": "0.35.5"
  }
}
