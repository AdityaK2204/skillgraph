{
  "description": "SkillGraph MongoDB collections: $jsonSchema validators and indexes. Applied by db/mongo/init.js (Docker) and by `npm run db:init`.",
  "collections": [
    {
      "name": "resumes_raw",
      "comment": "One document per uploaded resume. Sections and entries vary per resume, so only the fields the system relies on are pinned.",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["userId", "fileName", "text", "extracted", "parser", "createdAt"],
          "properties": {
            "userId":   { "bsonType": "string", "pattern": "^[0-9a-f-]{36}$", "description": "users.user_id in PostgreSQL" },
            "fileName": { "bsonType": "string", "maxLength": 255 },
            "mimeType": { "enum": ["application/pdf", "text/plain"] },
            "text":     { "bsonType": "string", "maxLength": 200000 },
            "sections": { "bsonType": "object", "description": "heading -> raw lines; keys vary per resume" },
            "extracted": {
              "bsonType": "object",
              "required": ["skills"],
              "properties": {
                "skills": {
                  "bsonType": "array",
                  "items": {
                    "bsonType": "object",
                    "required": ["skillId", "name", "mentions"],
                    "properties": {
                      "skillId":        { "bsonType": "int" },
                      "name":           { "bsonType": "string" },
                      "matchedTerm":    { "bsonType": "string" },
                      "mentions":       { "bsonType": "int", "minimum": 1 },
                      "sections":       { "bsonType": "array", "items": { "bsonType": "string" } },
                      "suggestedLevel": { "bsonType": "int", "minimum": 1, "maximum": 5 }
                    }
                  }
                },
                "unknownTerms": { "bsonType": "array", "items": { "bsonType": "string" } },
                "education":    { "bsonType": "array" },
                "projects":     { "bsonType": "array" },
                "links":        { "bsonType": "array" }
              }
            },
            "parser":    { "bsonType": "object", "required": ["name", "version"] },
            "createdAt": { "bsonType": "date" }
          }
        }
      },
      "indexes": [
        { "key": { "userId": 1, "createdAt": -1 } },
        { "key": { "extracted.skills.skillId": 1 }, "options": { "name": "skills_multikey" } },
        { "key": { "text": "text" }, "options": { "name": "resume_fulltext" } }
      ]
    },
    {
      "name": "job_sources",
      "comment": "Raw postings exactly as each source delivered them; `normalized` holds the agreed shape copied into PostgreSQL.",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["source", "externalId", "payload", "status", "ingestedAt"],
          "properties": {
            "source":     { "bsonType": "string", "description": "portal / feed name" },
            "externalId": { "bsonType": "string" },
            "payload":    { "bsonType": "object", "description": "raw record, schema differs per source" },
            "normalized": {
              "bsonType": "object",
              "properties": {
                "title":   { "bsonType": "string" },
                "company": { "bsonType": "string" },
                "location": { "bsonType": "string" },
                "skills":  { "bsonType": "array", "items": { "bsonType": "string" } }
              }
            },
            "status":     { "enum": ["received", "normalized", "rejected"] },
            "pgJobId":    { "bsonType": "string" },
            "ingestedAt": { "bsonType": "date" }
          }
        }
      },
      "indexes": [
        { "key": { "source": 1, "externalId": 1 }, "options": { "unique": true } },
        { "key": { "status": 1, "ingestedAt": -1 } }
      ]
    },
    {
      "name": "activity_log",
      "comment": "Append-only user events; expire after 180 days (TTL index).",
      "validator": {
        "$jsonSchema": {
          "bsonType": "object",
          "required": ["userId", "type", "at"],
          "properties": {
            "userId": { "bsonType": "string" },
            "type":   { "enum": ["login", "resume_uploaded", "skills_imported", "roadmap_generated", "item_completed",
                                 "evidence_submitted", "evidence_reviewed", "goal_set", "job_viewed"] },
            "meta":   { "bsonType": "object" },
            "at":     { "bsonType": "date" },
            "day":    { "bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "UTC day bucket written with the event" }
          }
        }
      },
      "indexes": [
        { "key": { "userId": 1, "at": -1 } },
        { "key": { "day": 1 } },
        { "key": { "at": 1 }, "options": { "expireAfterSeconds": 15552000, "name": "ttl_180_days" } }
      ]
    }
  ]
}
