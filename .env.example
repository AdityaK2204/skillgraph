# ---------------------------------------------------------------
# SkillGraph configuration. Copy to .env and change every password.
# .env is git-ignored: credentials never go into source control.
# ---------------------------------------------------------------

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=change-me-postgres-superuser
APP_DB_PASSWORD=change-me-app-role
# The web app connects as the least-privilege role created by db/postgres/04_app_role.sh
DATABASE_URL=postgres://skillgraph_app:change-me-app-role@localhost:5432/skillgraph
# Used only by `npm run db:init` (schema creation) — never by the web app
DATABASE_ADMIN_URL=postgres://postgres:change-me-postgres-superuser@localhost:5432/skillgraph

# --- MongoDB ---
MONGO_ROOT_PASSWORD=change-me-mongo-root
MONGO_APP_PASSWORD=change-me-mongo-app
MONGODB_URI=mongodb://skillgraph_app:change-me-mongo-app@localhost:27017/skillgraph?authSource=skillgraph
MONGODB_DB=skillgraph

# --- Neo4j ---
NEO4J_PASSWORD=change-me-neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# --- Auth ---
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
SESSION_HOURS=12

# --- Embeddings ---
# minilm : sentence-transformers/all-MiniLM-L6-v2 (384-d) run locally via Transformers.js;
#          the model (~23 MB) downloads from Hugging Face on first use.
# hash   : deterministic 384-d feature-hashing embedding, no download (offline fallback).
EMBEDDING_PROVIDER=minilm

# --- Demo data (npm run seed) ---
SEED_DEMO_PASSWORD=Demo@12345
